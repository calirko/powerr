PORT=3050
AUTH_TOKEN=change-me-to-a-long-random-secret
UI_PASSWORD=change-me-to-a-simple-password
DATABASE_URL="file:./prisma/dev.db"

# Pushed to the ESP32 on every connect (no reflash needed). PC_HOST_IP is the
# LAN IP of the PC's NIC to ping-probe; leave empty to disable the probe.
PC_HOST_IP=192.168.1.50
# PC_PING_INTERVAL_MS=5000
# PC_PING_COUNT=4
# HEARTBEAT_INTERVAL_MS=3000
# LONG_HOLD_THRESHOLD_MS=2000
