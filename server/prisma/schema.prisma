// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model PowerEvent {
  id        Int      @id @default(autoincrement())
  // Who/what the event is about: "button" = physical case button pass-through,
  // "remote" = triggered via POST /power, "device" = the ESP32's link to the
  // server, "pc" = the target machine's observed power state.
  source    String
  // What happened within that source: "pulse" (remote), "press"/"release"
  // (button), "connected"/"disconnected" (device), "on"/"off" (pc).
  kind      String   @default("pulse")
  // Relay hold time in ms. For button events this is left null (duration is
  // however long the button was actually held, tracked by press/release pairs).
  holdMs    Int?
  // For button events: true = press, false = release. Null for remote events.
  pressed   Boolean?
  ok        Boolean  @default(true)
  error     String?
  createdAt DateTime @default(now())
}
